"""
Genome Annotation Pipeline
BUSCO → RepeatModeler/EDTA → RepeatMasker → [IsoSeq mapping] → BRAKER3 → DIAMOND NR → InterProScan

Notes:
- BRAKER3 runs via Docker (teambraker/braker3:latest); conda env is NOT used.
  braker4-allinone:latest is missing Scalar::Util::Numeric and cannot be used.
- RepeatModeler scales as O(n²) with genome size; for genomes >1.5 GB use
  repeat_tool: "edta" (structural detection, ~24-48 h vs weeks for RepeatModeler).
- BRAKER3 workingdir must be chmod 777 before docker run (container runs as root).
- BRAKER3 writes augustus.hints.aa; braker.aa symlink may not exist → handled below.
- IsoSeq: set isoseq_dir to a directory of *.hifi_reads.fastq.gz files.
  Samples are auto-discovered; each is mapped with minimap2 splice:hq and merged
  into rna_mapping/merged_rna.bam, which is automatically passed to BRAKER3.
  isoseq_threads (default 16) × number of samples = total cores used during mapping.
  ALWAYS provide isoseq_dir (or rnaseq_bam) when RNA evidence is available —
  protein-only BRAKER3 produces noticeably lower-quality gene models.
"""

import glob
import sys
from pathlib import Path

# ── Config ────────────────────────────────────────────────────────────────────
GENOME_FA       = config["genome_fasta"]
SPECIES_NAME    = config["species_name"]
OUTDIR          = Path(config["outdir"])

PROTEIN_FA      = config.get("protein_fasta", "")

# IsoSeq: auto-discover samples from isoseq_dir; overrides rnaseq_bam if set
ISOSEQ_DIR      = config.get("isoseq_dir", "")
ISOSEQ_THREADS  = int(config.get("isoseq_threads", 16))  # per sample

if ISOSEQ_DIR:
    _fastqs        = sorted(glob.glob(f"{ISOSEQ_DIR}/*.hifi_reads.fastq.gz"))
    ISOSEQ_SAMPLES = [Path(f).name.replace(".hifi_reads.fastq.gz", "") for f in _fastqs]
    if not ISOSEQ_SAMPLES:
        raise ValueError(f"isoseq_dir={ISOSEQ_DIR} contains no *.hifi_reads.fastq.gz files")
    RNASEQ_BAM = str(OUTDIR / "rna_mapping" / "merged_rna.bam")
else:
    ISOSEQ_SAMPLES = []
    RNASEQ_BAM     = config.get("rnaseq_bam", "")

REPEAT_STRATEGY = config.get("repeat_strategy", "standard")
RM_PA           = int(config.get("repeatmodeler_pa", 4))
GENOME_SPLIT_N  = int(config.get("genome_split_n", 4))
RECOVER_DIR     = config.get("recover_dir", "")

# repeat_tool controls which TE annotation tools run:
#   "repeatmodeler" (default) — RepeatModeler only, ~50-100h for 1 Gb genome
#   "edta"                    — EDTA only, ~5-15h; faster but misses some SINE/small repeats
#   "both"                    — run both and merge libraries; best sensitivity, slowest
REPEAT_TOOL = config.get("repeat_tool", "edta")
USE_EDTA    = REPEAT_TOOL in ("edta", "both")

RUN_BUSCO       = str(config.get("run_busco", "true")).lower() == "true"
BUSCO_LINEAGE   = config.get("busco_lineage", "vertebrata_odb10")

NR_DB           = config.get("nr_diamond_db", "/home/cylin/Vet_Hamaguri/databases/nr.dmnd")
EGGNOG_DATA     = config.get("eggnog_data_dir", "/home/cylin/Vet_Hamaguri/databases/eggnog_data")
INTERPROSCAN    = config.get("interproscan_dir", "/home/cylin/Vet_Hamaguri/databases/interproscan-5.73-104.0")

THREADS         = int(config.get("threads", 64))
MEM_GB          = int(config.get("mem_gb", 256))

RUN_SYNTENY     = str(config.get("run_synteny", "false")).lower() == "true"
HAP2_FA         = config.get("hap2_fasta", "")
SYNTENY_THREADS = int(config.get("synteny_threads", 16))

if RUN_SYNTENY and not HAP2_FA:
    raise ValueError("run_synteny=true requires hap2_fasta to be set in config")

# Per-tool thread overrides — allows parallel execution of downstream rules.
# When busco_threads + diamond_threads + ipr_threads == total cores, all three
# run simultaneously after BRAKER3 completes (e.g. 40+80+40 = 160 cores).
BUSCO_THREADS   = int(config.get("busco_threads",   40))
DIAMOND_THREADS = int(config.get("diamond_threads", 80))
IPR_THREADS     = int(config.get("ipr_threads",     40))

RM_DB_PREFIX    = str(OUTDIR / "repeats" / "rmdb" / SPECIES_NAME)
CHUNKS          = [f"{i:03d}" for i in range(GENOME_SPLIT_N)]
RM_CHUNK_THREADS = max(4, THREADS // GENOME_SPLIT_N)

# Compute the canonical repeat library path based on repeat_tool mode
if REPEAT_TOOL == "edta":
    FINAL_REPEAT_LIB = str(OUTDIR / "repeats" / "edta" / f"{Path(GENOME_FA).name}.mod.EDTA.final" / f"{Path(GENOME_FA).name}.mod.EDTA.TElib.fa")
elif REPEAT_TOOL == "both":
    FINAL_REPEAT_LIB = str(OUTDIR / "repeats" / f"{SPECIES_NAME}-combined.fa")
else:
    FINAL_REPEAT_LIB = str(OUTDIR / "repeats" / f"{SPECIES_NAME}-families.fa")

wildcard_constraints:
    chunk  = r"[0-9]{3}",
    sample = r"[^/]+",

# ── Preflight: resource check before any job starts ───────────────────────────
onstart:
    import sys as _sys
    _sys.path.insert(0, str(Path(workflow.snakefile).parent.parent / "common"))
    from preflight import preflight
    preflight(config, workflow_name="genome_annotation", needs_docker=True)


# ── Target rule ───────────────────────────────────────────────────────────────
rule all:
    input:
        str(OUTDIR / "busco" / "short_summary.txt") if RUN_BUSCO else [],
        FINAL_REPEAT_LIB,
        str(OUTDIR / "masked" / f"{SPECIES_NAME}.masked.fa"),
        str(OUTDIR / "braker4" / "braker.gtf"),
        str(OUTDIR / "annotation" / "diamond_nr.tsv"),
        str(OUTDIR / "annotation" / "interproscan.tsv"),
        str(OUTDIR / "busco_proteins" / "short_summary.txt"),
        str(OUTDIR / "synteny" / "plotsr.pdf") if RUN_SYNTENY else [],

# ── BUSCO ─────────────────────────────────────────────────────────────────────
if RUN_BUSCO:
    rule busco:
        input:
            genome = GENOME_FA,
        output:
            summary = str(OUTDIR / "busco" / "short_summary.txt"),
        params:
            lineage = BUSCO_LINEAGE,
            outdir  = str(OUTDIR / "busco"),
        threads: THREADS
        resources:
            mem_mb = 32 * 1024,
        conda: "envs/busco.yaml"
        shell:
            """
            set -euo pipefail
            busco -i {input.genome} \
                  -l {params.lineage} \
                  -o busco_run \
                  --out_path {params.outdir} \
                  -m genome \
                  --cpu {threads} \
                  --force
            # BUSCO 5+ writes short_summary.specific.<lineage>.<name>.txt
            # Use find to locate it robustly rather than relying on glob expansion
            found=$(find {params.outdir}/busco_run -name "short_summary*.txt" | head -1)
            test -n "$found" || {{ echo "ERROR: BUSCO short_summary not found" >&2; exit 1; }}
            cp "$found" {output.summary}
            """

if REPEAT_TOOL != "edta" and REPEAT_STRATEGY == "standard":
    rule repeatmodeler_db:
        input:
            genome = GENOME_FA,
        output:
            multiext(RM_DB_PREFIX, ".nhr", ".nin", ".nsq"),
        params:
            dbdir = str(OUTDIR / "repeats" / "rmdb"),
            name  = SPECIES_NAME,
        conda: "envs/repeatmodeler.yaml"
        shell:
            """
            set -euo pipefail
            mkdir -p {params.dbdir}
            cd {params.dbdir}
            BuildDatabase -name {params.name} -engine ncbi {input.genome}
            """

    rule repeatmodeler:
        input:
            multiext(RM_DB_PREFIX, ".nhr", ".nin", ".nsq"),
        output:
            lib = str(OUTDIR / "repeats" / f"{SPECIES_NAME}-families.fa"),
            stk = str(OUTDIR / "repeats" / f"{SPECIES_NAME}-families.stk"),
        params:
            db      = RM_DB_PREFIX,
            pa      = RM_PA,
            outdir  = str(OUTDIR / "repeats"),
            recover = f"-recoverDir {RECOVER_DIR}" if RECOVER_DIR else "",
        threads: THREADS
        resources:
            mem_mb = MEM_GB * 1024,
        conda: "envs/repeatmodeler.yaml"
        shell:
            """
            set -euo pipefail
            cd {params.outdir}
            RepeatModeler \
                -database {params.db} \
                -pa {params.pa} \
                -engine ncbi \
                -LTRStruct \
                {params.recover}
            test -s {output.lib} || {{ echo "ERROR: RepeatModeler produced no repeat library" >&2; exit 1; }}
            """

# ══════════════════════════════════════════════════════════════════════════════
# RepeatModeler — Strategy: parallel (genome segmentation)
#
# Genome is split into N chunks. Each chunk has ~n/N sequences, so per-chunk
# BLAST work is (n/N)² instead of n². N chunks run simultaneously.
# Total BLAST calls: N × (n/N)² = n²/N  (run in parallel → wall-clock n²/N²)
# For N=4: 16× theoretical speedup over single-threaded -pa 1.
#
# Trade-off: repeat families that span chunk boundaries may be missed or
# fragmented (~5% of families for a well-balanced split). The CD-HIT-EST
# merge step at 80% identity recovers most cross-chunk redundancy.
# ══════════════════════════════════════════════════════════════════════════════
if REPEAT_TOOL != "edta" and REPEAT_STRATEGY != "standard":
    rule split_genome:
        input:
            genome = GENOME_FA,
        output:
            expand(str(OUTDIR / "repeats" / "chunks" / "chunk_{chunk}.fa"), chunk=CHUNKS),
        params:
            outdir = str(OUTDIR / "repeats" / "chunks"),
            n      = GENOME_SPLIT_N,
        conda: "envs/utils.yaml"
        script: "scripts/split_genome.py"

    rule repeatmodeler_db_chunk:
        input:
            genome = str(OUTDIR / "repeats" / "chunks" / "chunk_{chunk}.fa"),
        output:
            multiext(
                str(OUTDIR / "repeats" / "chunks" / "db_{chunk}" / SPECIES_NAME),
                ".nhr", ".nin", ".nsq",
            ),
        params:
            dbdir = str(OUTDIR / "repeats" / "chunks" / "db_{chunk}"),
            name  = SPECIES_NAME,
        conda: "envs/repeatmodeler.yaml"
        shell:
            """
            set -euo pipefail
            mkdir -p {params.dbdir}
            cd {params.dbdir}
            BuildDatabase -name {params.name} -engine ncbi {input.genome}
            """

    rule repeatmodeler_chunk:
        input:
            multiext(
                str(OUTDIR / "repeats" / "chunks" / "db_{chunk}" / SPECIES_NAME),
                ".nhr", ".nin", ".nsq",
            ),
        output:
            lib = str(OUTDIR / "repeats" / "segments" / "chunk_{chunk}-families.fa"),
        params:
            db     = str(OUTDIR / "repeats" / "chunks" / "db_{chunk}" / SPECIES_NAME),
            outdir = str(OUTDIR / "repeats" / "segments" / "chunk_{chunk}"),
            pa     = max(1, RM_PA // GENOME_SPLIT_N),
        threads: RM_CHUNK_THREADS
        resources:
            mem_mb = (MEM_GB * 1024) // GENOME_SPLIT_N,
        conda: "envs/repeatmodeler.yaml"
        shell:
            """
            set -euo pipefail
            mkdir -p {params.outdir}
            cd {params.outdir}
            RepeatModeler \
                -database {params.db} \
                -pa {params.pa} \
                -engine ncbi \
                -LTRStruct
            # RepeatModeler writes output to working dir; locate and copy.
            # Only write placeholder if RepeatModeler exited 0 but found no repeats
            # (legitimate for small chunks). If RepeatModeler crashed, set -e catches it above.
            found=$(find {params.outdir} -name "*-families.fa" | head -1)
            if [ -n "$found" ]; then
                cp "$found" {output.lib}
            else
                printf ">chunk_{wildcards.chunk}_no_repeats_found\\nN\\n" > {output.lib}
            fi
            test -s {output.lib} || {{ echo "ERROR: chunk repeat library empty" >&2; exit 1; }}
            """

    rule merge_repeat_libs:
        input:
            libs = expand(
                str(OUTDIR / "repeats" / "segments" / "chunk_{chunk}-families.fa"),
                chunk=CHUNKS,
            ),
        output:
            lib = str(OUTDIR / "repeats" / f"{SPECIES_NAME}-families.fa"),
        params:
            raw = str(OUTDIR / "repeats" / "merged_raw.fa"),
        threads: min(THREADS, 16)
        resources:
            mem_mb = 32 * 1024,
        conda: "envs/utils.yaml"
        shell:
            """
            set -euo pipefail
            cat {input.libs} > {params.raw}

            # Cluster at 80% identity to remove cross-chunk redundant families.
            # -aS 0.8: alignment covers ≥80% of shorter sequence
            # This is equivalent to the k-mer similarity filter described in the
            # optimization notes: families that are ≥80% similar get merged into
            # one representative, reducing RepeatMasker's search library by ~30–50%.
            cd-hit-est \
                -i {params.raw} \
                -o {output.lib} \
                -c 0.80 \
                -aS 0.80 \
                -n 8 \
                -T {threads} \
                -M {resources.mem_mb} \
                -d 0
            rm -f {params.raw}
            test -s {output.lib} || {{ echo "ERROR: merged repeat library empty" >&2; exit 1; }}
            """

# ── EDTA: structural TE annotation ────────────────────────────────────────────
# repeat_tool: edta   → EDTA only (~5-15h); skips RepeatModeler entirely
# repeat_tool: both   → run both and merge; best sensitivity
# Uses structural features (TSD, LTR length, TIR palindrome), not all-vs-all BLAST.
if USE_EDTA:
    rule edta:
        input:
            genome = GENOME_FA,
        output:
            lib = str(OUTDIR / "repeats" / "edta" / f"{Path(GENOME_FA).name}.mod.EDTA.final" / f"{Path(GENOME_FA).name}.mod.EDTA.TElib.fa"),
        params:
            outdir = str(OUTDIR / "repeats" / "edta"),
            genome = GENOME_FA,
        threads: THREADS
        resources:
            mem_mb = MEM_GB * 1024,
        conda: "envs/edta.yaml"
        shell:
            """
            set -euo pipefail
            mkdir -p {params.outdir}
            cd {params.outdir}
            EDTA.pl \
                --genome {params.genome} \
                --species others \
                --step all \
                --threads {threads} \
                --force 1
            test -s {output.lib} || {{ echo "ERROR: EDTA TElib missing or empty" >&2; exit 1; }}
            """

    rule merge_rm_edta:
        input:
            rm_lib   = str(OUTDIR / "repeats" / f"{SPECIES_NAME}-families.fa"),
            edta_lib = str(OUTDIR / "repeats" / "edta" / f"{Path(GENOME_FA).name}.mod.EDTA.final" / f"{Path(GENOME_FA).name}.mod.EDTA.TElib.fa"),
        output:
            lib = str(OUTDIR / "repeats" / f"{SPECIES_NAME}-combined.fa"),
        params:
            raw = str(OUTDIR / "repeats" / "combined_raw.fa"),
        threads: min(THREADS, 16)
        resources:
            mem_mb = 32 * 1024,
        conda: "envs/utils.yaml"
        shell:
            """
            set -euo pipefail
            cat {input.rm_lib} {input.edta_lib} > {params.raw}
            cd-hit-est -i {params.raw} -o {output.lib} \
                -c 0.80 -aS 0.80 -n 8 -T {threads} -M {resources.mem_mb} -d 0
            rm -f {params.raw}
            test -s {output.lib} || {{ echo "ERROR: combined repeat library empty" >&2; exit 1; }}
            """

def final_repeat_lib(wildcards):
    return FINAL_REPEAT_LIB

# ── RepeatMasker: soft-mask ───────────────────────────────────────────────────
rule repeatmasker:
    input:
        genome = GENOME_FA,
        lib    = final_repeat_lib,
    output:
        masked = str(OUTDIR / "masked" / f"{SPECIES_NAME}.masked.fa"),
        gff    = str(OUTDIR / "masked" / f"{SPECIES_NAME}.out.gff"),
    params:
        outdir = str(OUTDIR / "masked"),
        gname  = Path(GENOME_FA).name,
    threads: THREADS
    resources:
        mem_mb = 64 * 1024,
    conda: "envs/repeatmodeler.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        RepeatMasker \
            -pa {threads} \
            -lib {input.lib} \
            -gff \
            -xsmall \
            -dir {params.outdir} \
            {input.genome}
        test -f {params.outdir}/{params.gname}.masked || \
            {{ echo "ERROR: RepeatMasker did not produce .masked output — check repeat library and genome" >&2; exit 1; }}
        mv {params.outdir}/{params.gname}.masked {output.masked}
        test -s {output.masked} || {{ echo "ERROR: masked genome is empty" >&2; exit 1; }}
        mv {params.outdir}/{params.gname}.out.gff {output.gff} 2>/dev/null || touch {output.gff}
        """

# ── IsoSeq HiFi mapping → BRAKER3 RNA hints ──────────────────────────────────
# Activated when isoseq_dir is set in config.
# Samples (*.hifi_reads.fastq.gz) are auto-discovered and mapped in parallel.
# isoseq_threads (default 16) × n_samples cores are used simultaneously.
# Output merged_rna.bam is passed automatically to BRAKER3 --bam flag.
if ISOSEQ_SAMPLES:
    rule isoseq_genome_index:
        input:
            genome = str(OUTDIR / "masked" / f"{SPECIES_NAME}.masked.fa"),
        output:
            mmi = str(OUTDIR / "rna_mapping" / "genome_splice.mmi"),
        threads: 20
        resources: mem_mb = 24 * 1024
        conda: "envs/minimap2.yaml"
        shell:
            """
            set -euo pipefail
            mkdir -p $(dirname {output.mmi})
            minimap2 -t {threads} -x splice:hq -uf -d {output.mmi} {input.genome}
            test -s {output.mmi} || {{ echo "ERROR: genome index empty" >&2; exit 1; }}
            """

    rule isoseq_map:
        input:
            mmi   = str(OUTDIR / "rna_mapping" / "genome_splice.mmi"),
            fastq = str(Path(ISOSEQ_DIR) / "{sample}.hifi_reads.fastq.gz"),
        output:
            bam = str(OUTDIR / "rna_mapping" / "{sample}.sort.bam"),
            bai = str(OUTDIR / "rna_mapping" / "{sample}.sort.bam.bai"),
        threads: ISOSEQ_THREADS
        resources: mem_mb = ISOSEQ_THREADS * 4 * 1024
        conda: "envs/minimap2.yaml"
        shell:
            """
            set -euo pipefail
            minimap2 -ax splice:hq -uf --secondary=no -C5 \
                -t {threads} {input.mmi} {input.fastq} \
            | samtools sort -@ {threads} -m 4G \
                -T {output.bam}_tmp -o {output.bam}
            samtools index -@ 8 {output.bam}
            test -s {output.bam} || {{ echo "ERROR: {wildcards.sample} BAM empty" >&2; exit 1; }}
            test -s {output.bai} || {{ echo "ERROR: {wildcards.sample} BAI missing" >&2; exit 1; }}
            """

    rule isoseq_merge:
        input:
            bams = expand(
                str(OUTDIR / "rna_mapping" / "{sample}.sort.bam"),
                sample=ISOSEQ_SAMPLES,
            ),
        output:
            bam = str(OUTDIR / "rna_mapping" / "merged_rna.bam"),
            bai = str(OUTDIR / "rna_mapping" / "merged_rna.bam.bai"),
        threads: 32
        resources: mem_mb = 16 * 1024
        conda: "envs/minimap2.yaml"
        shell:
            """
            set -euo pipefail
            samtools merge -f -@ {threads} {output.bam} {input.bams}
            samtools index -@ 16 {output.bam}
            samtools flagstat -@ 16 {output.bam}
            test -s {output.bam} || {{ echo "ERROR: merged_rna.bam empty" >&2; exit 1; }}
            test -s {output.bai} || {{ echo "ERROR: merged_rna.bam.bai missing" >&2; exit 1; }}
            """

# ── BRAKER3: gene prediction ──────────────────────────────────────────────────
# Uses teambraker/braker3:latest Docker (NOT braker4-allinone — missing Scalar::Util::Numeric).
# Container runs as root; workingdir must be chmod 777 before docker run.
# --user flag must NOT be used (breaks Perl module access inside container).
# Output may be braker.aa OR augustus.hints.aa — both are handled below.
rule braker4:
    input:
        genome      = str(OUTDIR / "masked" / f"{SPECIES_NAME}.masked.fa"),
        rnaseq      = [RNASEQ_BAM]         if RNASEQ_BAM else [],
        rnaseq_bai  = [RNASEQ_BAM + '.bai'] if RNASEQ_BAM else [],
        proteins    = [PROTEIN_FA]          if PROTEIN_FA else [],
    output:
        gtf  = str(OUTDIR / "braker4" / "braker.gtf"),
        aa   = str(OUTDIR / "braker4" / "braker.aa"),
    params:
        outdir     = str(OUTDIR / "braker4"),
        masked_dir = str(OUTDIR / "masked"),
        species    = SPECIES_NAME,
        prot_vol   = f"-v {Path(PROTEIN_FA).parent}:/proteins:ro" if PROTEIN_FA else "",
        rna_vol    = f"-v {Path(RNASEQ_BAM).parent}:/bam:ro"      if RNASEQ_BAM else "",
        rna_flag   = f"--bam=/bam/{Path(RNASEQ_BAM).name}"        if RNASEQ_BAM else "",
        prot_flag  = f"--prot_seq=/proteins/{Path(PROTEIN_FA).name}" if PROTEIN_FA else "",
    threads: THREADS
    resources:
        mem_mb = MEM_GB * 1024,
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        chmod 777 {params.outdir}
        # GeneMark-ETP requires BAM sequence names to match genome sequence names.
        # minimap2 truncates headers at the first space (e.g. "CM135227.1"), but
        # BRAKER3 replaces spaces with underscores ("CM135227.1_Meretrix_...").
        # Fix: pre-strip headers to the first word before passing to BRAKER3.
        sed 's/^\\(>[^ ]*\\) .*/\\1/' {input.genome} > {params.outdir}/genome_shortid.fa
        chmod 666 {params.outdir}/genome_shortid.fa
        docker run --rm \
            -v {params.masked_dir}:/masked:ro \
            {params.prot_vol} \
            {params.rna_vol} \
            -v {params.outdir}:/workingdir \
            teambraker/braker3:latest \
            braker.pl \
                --genome=/workingdir/genome_shortid.fa \
                --species={params.species} \
                --workingdir=/workingdir \
                --threads={threads} \
                --softmasking \
                --gff3 \
                {params.rna_flag} \
                {params.prot_flag}
        # Fix root-owned files (busybox avoids sudo password requirement)
        # || true: chown is best-effort; BRAKER3 container runs as root so outputs
        # are root-owned. If busybox image is missing, Snakemake will PermissionError
        # on touch — run `docker pull busybox` to fix. See PIPELINE_CHECKLIST BRAKER3 note.
        docker run --rm -v {params.outdir}:/workingdir busybox \
            sh -c "chown -R $(id -u):$(id -g) /workingdir" 2>/dev/null || true
        # BRAKER3 sometimes writes augustus.hints.aa instead of braker.aa
        if [ ! -f {output.aa} ] && [ -f {params.outdir}/augustus.hints.aa ]; then
            cp {params.outdir}/augustus.hints.aa {output.aa}
        fi
        test -s {output.gtf} || {{ echo "ERROR: braker.gtf missing or empty" >&2; exit 1; }}
        test -s {output.aa}  || {{ echo "ERROR: braker.aa missing or empty"  >&2; exit 1; }}
        """

# ── Protein extraction ────────────────────────────────────────────────────────
# Use braker.aa directly rather than AGAT re-extraction.
# AGAT fails when braker.gtf uses underscore-joined chromosome IDs
# (e.g. CM135227.1_Meretrix_...) that don't match the short FASTA IDs in
# masked.fa (CM135227.1). BRAKER3 already writes complete protein sequences
# to braker.aa; we only need to strip trailing stop-codon asterisks.
rule extract_proteins:
    input:
        aa = str(OUTDIR / "braker4" / "braker.aa"),
    output:
        prot = str(OUTDIR / "annotation" / "predicted_proteins.fa"),
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.prot})
        sed 's/\\*//g' {input.aa} > {output.prot}
        test -s {output.prot} || {{ echo "ERROR: predicted_proteins.fa missing or empty" >&2; exit 1; }}
        """

# ── BUSCO proteins: annotation completeness ───────────────────────────────────
# Evaluates what fraction of conserved single-copy orthologs are present in
# BRAKER3's predicted proteins. Complements genome-mode BUSCO (assembly QC).
rule busco_proteins:
    input:
        prot = str(OUTDIR / "annotation" / "predicted_proteins.fa"),
    output:
        summary = str(OUTDIR / "busco_proteins" / "short_summary.txt"),
    params:
        lineage = BUSCO_LINEAGE,
        outdir  = str(OUTDIR / "busco_proteins"),
    threads: BUSCO_THREADS
    resources:
        mem_mb = 32 * 1024,
    conda: "envs/busco.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        busco -i {input.prot} \
              -l {params.lineage} \
              -o busco_prot_run \
              --out_path {params.outdir} \
              -m protein \
              --cpu {threads} \
              --force
        found=$(find {params.outdir}/busco_prot_run -name "short_summary*.txt" | head -1)
        test -n "$found" || {{ echo "ERROR: BUSCO protein short_summary not found" >&2; exit 1; }}
        cp "$found" {output.summary}
        """

# ── DIAMOND NR ────────────────────────────────────────────────────────────────
rule diamond_nr:
    input:
        prot = str(OUTDIR / "annotation" / "predicted_proteins.fa"),
        db   = NR_DB,
    output:
        str(OUTDIR / "annotation" / "diamond_nr.tsv"),
    threads: DIAMOND_THREADS
    resources:
        mem_mb = 128 * 1024,
    conda: "envs/annotation.yaml"
    shell:
        """
        set -euo pipefail
        diamond blastp \
            --db {input.db} \
            --query {input.prot} \
            --out {output} \
            --threads {threads} \
            --block-size 10 \
            --outfmt 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle \
            --max-target-seqs 5 \
            --evalue 1e-5 \
            --sensitive
        test -s {output} || {{ echo "ERROR: diamond_nr.tsv empty — no hits or DIAMOND crash" >&2; exit 1; }}
        """

# ── InterProScan ──────────────────────────────────────────────────────────────
rule interproscan:
    input:
        prot = str(OUTDIR / "annotation" / "predicted_proteins.fa"),
    output:
        tsv  = str(OUTDIR / "annotation" / "interproscan.tsv"),
    params:
        ipr  = INTERPROSCAN,
    threads: IPR_THREADS
    resources:
        mem_mb = 128 * 1024,
    conda: "envs/annotation.yaml"
    shell:
        """
        set -euo pipefail
        {params.ipr}/interproscan.sh \
            -i {input.prot} \
            -o {output.tsv} \
            -f TSV \
            -cpu {threads} \
            -goterms \
            -iprlookup \
            --disable-precalc
        test -s {output.tsv} || {{ echo "ERROR: interproscan.tsv empty — check Java and InterProScan setup" >&2; exit 1; }}
        """


# ── Synteny (hap1 vs hap2, optional) ─────────────────────────────────────────
if RUN_SYNTENY:

    rule minimap2_synteny:
        """Whole-genome alignment of hap1 (query) vs hap2 (reference) for SyRI."""
        input:
            hap1 = GENOME_FA,
            hap2 = HAP2_FA,
        output:
            bam = str(OUTDIR / "synteny" / "hap1_vs_hap2.bam"),
            bai = str(OUTDIR / "synteny" / "hap1_vs_hap2.bam.csi"),
        threads: SYNTENY_THREADS
        resources: mem_mb = 32 * 1024
        conda: "envs/syri.yaml"
        shell:
            """
            set -euo pipefail
            mkdir -p {OUTDIR}/synteny
            minimap2 -a --cs -x asm5 -t {threads} \
                {input.hap2} {input.hap1} \
            | samtools sort -@ 4 -m 4G -o {output.bam}
            samtools index --csi {output.bam}
            test -s {output.bam} || {{ echo "ERROR: synteny BAM empty" >&2; exit 1; }}
            test -s {output.bai} || {{ echo "ERROR: synteny BAI empty" >&2; exit 1; }}
            """

    rule syri:
        """Detect synteny blocks and structural rearrangements between hap1 and hap2."""
        input:
            bam  = str(OUTDIR / "synteny" / "hap1_vs_hap2.bam"),
            bai  = str(OUTDIR / "synteny" / "hap1_vs_hap2.bam.csi"),
            hap1 = GENOME_FA,
            hap2 = HAP2_FA,
        output:
            out     = str(OUTDIR / "synteny" / "syri.out"),
            summary = str(OUTDIR / "synteny" / "syri.summary"),
        params:
            prefix = str(OUTDIR / "synteny") + "/",
        resources: mem_mb = 32 * 1024
        conda: "envs/syri.yaml"
        shell:
            """
            set -euo pipefail
            syri \
                -c {input.bam} \
                -f {input.hap1} \
                -r {input.hap2} \
                -k -F B \
                --prefix {params.prefix}
            test -s {output.out}     || {{ echo "ERROR: syri.out empty" >&2; exit 1; }}
            test -s {output.summary} || {{ echo "ERROR: syri.summary empty" >&2; exit 1; }}
            """

    rule plotsr:
        """Visualise hap1/hap2 synteny with plotsr."""
        input:
            syri_out = str(OUTDIR / "synteny" / "syri.out"),
            hap1     = GENOME_FA,
            hap2     = HAP2_FA,
        output:
            pdf = str(OUTDIR / "synteny" / "plotsr.pdf"),
        params:
            outdir    = str(OUTDIR / "synteny"),
            hap1_name = Path(GENOME_FA).stem,
            hap2_name = Path(HAP2_FA).stem if HAP2_FA else "hap2",
        resources: mem_mb = 8 * 1024
        conda: "envs/syri.yaml"
        shell:
            """
            set -euo pipefail
            # Build genomes.txt required by plotsr
            GENOMES={params.outdir}/genomes.txt
            printf '#file\tname\ttags\n'                            >  "$GENOMES"
            printf '%s\t%s\tlw:1.5\n' '{input.hap1}' '{params.hap1_name}' >> "$GENOMES"
            printf '%s\t%s\tlw:1.5\n' '{input.hap2}' '{params.hap2_name}' >> "$GENOMES"
            plotsr \
                --sr {input.syri_out} \
                --genomes "$GENOMES" \
                -o {output.pdf} \
                -H 8 -W 5
            test -s {output.pdf} || {{ echo "ERROR: plotsr PDF empty" >&2; exit 1; }}
            """
