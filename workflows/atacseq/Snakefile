import sys
"""
ATAC-seq pipeline: open chromatin peak calling + differential accessibility
FastQC → fastp → Bowtie2 → samtools markdup → MACS3 → DiffBind
"""

from pathlib import Path
import csv

# ── Config ────────────────────────────────────────────────────────────────────
SAMPLESHEET  = config["samplesheet"]
OUTDIR       = Path(config["outdir"])
GENOME_FA    = config["genome_fasta"]
GENOME_SIZE  = config.get("genome_size", "2.7e9")
BLACKLIST    = config.get("blacklist", "")
COMPARISONS  = config.get("comparisons", [])
PADJ_THRESH  = float(config.get("padj_threshold", 0.05))
LFC_THRESH   = float(config.get("log2fc_threshold", 1.0))
THREADS      = int(config.get("threads", 64))
MEM_GB       = int(config.get("mem_gb", 128))

def _read_samplesheet(path):
    ss = {}
    with open(path) as fh:
        for row in csv.DictReader(fh):
            sid = row["sample"].strip()
            ss[sid] = {"group": row["group"].strip(),
                       "r1":    row["r1"].strip(),
                       "r2":    row["r2"].strip()}
    if not ss:
        raise ValueError(f"Samplesheet '{path}' has no valid rows")
    return ss

_SS      = _read_samplesheet(SAMPLESHEET)
SAMPLES  = list(_SS.keys())
CONTRASTS = [f"{c[0]}_vs_{c[1]}" for c in COMPARISONS]
BT2_INDEX = str(OUTDIR / "bowtie2_index" / "genome")

# ── Target rule ───────────────────────────────────────────────────────────────
# ── Preflight: resource check before any job starts ───────────────────────────
onstart:
    import sys as _sys
    _sys.path.insert(0, str(Path(workflow.snakefile).parent.parent / "common"))
    from preflight import preflight
    preflight(config, workflow_name="atacseq")


rule all:
    input:
        str(OUTDIR / "multiqc" / "multiqc_report.html"),
        expand(str(OUTDIR / "peaks" / "{sample}_peaks.narrowPeak"), sample=SAMPLES),
        expand(str(OUTDIR / "diffbind" / "{contrast}_results.tsv"), contrast=CONTRASTS),

# ── QC ────────────────────────────────────────────────────────────────────────
rule fastqc:
    input:
        r1 = lambda wc: _SS[wc.sample]["r1"],
        r2 = lambda wc: _SS[wc.sample]["r2"],
    output:
        z1 = str(OUTDIR / "fastqc" / "{sample}_R1_fastqc.zip"),
        z2 = str(OUTDIR / "fastqc" / "{sample}_R2_fastqc.zip"),
    params:
        outdir = str(OUTDIR / "fastqc"),
    threads: 4
    resources:
        mem_mb = 4 * 1024,
    conda: "envs/qc.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        fastqc -t {threads} -o {params.outdir} {input.r1} {input.r2}
        test -s {output.z1} || {{ echo 'ERROR: FastQC zip R1 empty' >&2; exit 1; }}
        test -s {output.z2} || {{ echo 'ERROR: FastQC zip R2 empty' >&2; exit 1; }}
        """

rule fastp:
    input:
        r1 = lambda wc: _SS[wc.sample]["r1"],
        r2 = lambda wc: _SS[wc.sample]["r2"],
    output:
        r1   = str(OUTDIR / "trimmed" / "{sample}_R1.fastq.gz"),
        r2   = str(OUTDIR / "trimmed" / "{sample}_R2.fastq.gz"),
        html = str(OUTDIR / "fastp"   / "{sample}.html"),
        json = str(OUTDIR / "fastp"   / "{sample}.json"),
    threads: 16
    resources:
        mem_mb = 8 * 1024,
    conda: "envs/qc.yaml"
    shell:
        """
        set -euo pipefail
        fastp -i {input.r1} -I {input.r2} \
              -o {output.r1} -O {output.r2} \
              -h {output.html} -j {output.json} \
              --thread {threads} \
              --detect_adapter_for_pe \
              --qualified_quality_phred 20 \
              --length_required 25
        test -s {output.r1} || {{ echo 'ERROR: fastp R1 output empty' >&2; exit 1; }}
        test -s {output.r2} || {{ echo 'ERROR: fastp R2 output empty' >&2; exit 1; }}
        """

# ── Bowtie2 index ─────────────────────────────────────────────────────────────
rule bowtie2_index:
    input:
        genome = GENOME_FA,
    output:
        multiext(BT2_INDEX, ".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2", ".rev.1.bt2", ".rev.2.bt2"),
    params:
        prefix = BT2_INDEX,
    threads: THREADS
    resources:
        mem_mb = 32 * 1024,
    conda: "envs/align.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {params.prefix})
        bowtie2-build --threads {threads} {input.genome} {params.prefix}
        """

# ── Align ─────────────────────────────────────────────────────────────────────
rule bowtie2:
    input:
        r1  = str(OUTDIR / "trimmed" / "{sample}_R1.fastq.gz"),
        r2  = str(OUTDIR / "trimmed" / "{sample}_R2.fastq.gz"),
        idx = multiext(BT2_INDEX, ".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2", ".rev.1.bt2", ".rev.2.bt2"),
    output:
        bam = temp(str(OUTDIR / "aligned" / "{sample}.raw.bam")),
    params:
        index = BT2_INDEX,
    threads: THREADS
    resources:
        mem_mb = MEM_GB * 1024,
    conda: "envs/align.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.bam})
        bowtie2 -x {params.index} \
                -1 {input.r1} -2 {input.r2} \
                --no-mixed --no-discordant \
                -X 2000 \
                --threads {threads} | \
        samtools view -bS -q 10 -F 1804 - | \
        samtools sort -@ {threads} -m 2G -o {output.bam}
        test -s {output.bam} || {{ echo 'ERROR: bowtie2 BAM empty' >&2; exit 1; }}
        """

# ── Mark duplicates ───────────────────────────────────────────────────────────
rule markdup:
    input:
        bam = str(OUTDIR / "aligned" / "{sample}.raw.bam"),
    output:
        bam  = str(OUTDIR / "aligned" / "{sample}.markdup.bam"),
        # samtools >= 1.12 on large/non-standard references writes CSI (.bam.csi)
        # instead of BAI (.bam.bai); align.yaml pins samtools=1.20 so use .csi
        bai  = str(OUTDIR / "aligned" / "{sample}.markdup.bam.csi"),
        stat = str(OUTDIR / "aligned" / "{sample}.markdup.flagstat"),
    threads: 8
    resources:
        mem_mb = 32 * 1024,
    conda: "envs/align.yaml"
    shell:
        """
        set -euo pipefail
        samtools markdup -@ {threads} --write-index {input.bam} {output.bam}
        test -s {output.bam} || {{ echo 'ERROR: markdup BAM empty' >&2; exit 1; }}
        samtools flagstat -@ {threads} {output.bam} > {output.stat}
        test -s {output.stat} || {{ echo 'ERROR: flagstat empty' >&2; exit 1; }}
        """

# ── Optional: remove blacklist regions ───────────────────────────────────────
if BLACKLIST:
    rule blacklist_filter:
        input:
            bam  = str(OUTDIR / "aligned" / "{sample}.markdup.bam"),
            bai  = str(OUTDIR / "aligned" / "{sample}.markdup.bam.csi"),
            bl   = BLACKLIST,
        output:
            bam  = str(OUTDIR / "aligned" / "{sample}.filtered.bam"),
            bai  = str(OUTDIR / "aligned" / "{sample}.filtered.bam.csi"),
        threads: 8
        conda: "envs/align.yaml"
        shell:
            """
            set -euo pipefail
            bedtools intersect -v -abam {input.bam} -b {input.bl} > {output.bam}
            test -s {output.bam} || {{ echo 'ERROR: filtered BAM empty' >&2; exit 1; }}
            samtools index -@ {threads} -c {output.bam}
            test -s {output.bai} || {{ echo 'ERROR: filtered BAM index empty' >&2; exit 1; }}
            """

def final_bam(wc):
    if BLACKLIST:
        return str(OUTDIR / "aligned" / f"{wc.sample}.filtered.bam")
    return str(OUTDIR / "aligned" / f"{wc.sample}.markdup.bam")

def final_bam_list(_wc):
    """Return per-sample BAM paths for DiffBind input (respects BLACKLIST)."""
    if BLACKLIST:
        return [str(OUTDIR / "aligned" / f"{s}.filtered.bam") for s in SAMPLES]
    return [str(OUTDIR / "aligned" / f"{s}.markdup.bam") for s in SAMPLES]

def final_bai_list(_wc):
    """Return per-sample BAM index paths for DiffBind input (CSI, respects BLACKLIST)."""
    if BLACKLIST:
        return [str(OUTDIR / "aligned" / f"{s}.filtered.bam.csi") for s in SAMPLES]
    return [str(OUTDIR / "aligned" / f"{s}.markdup.bam.csi") for s in SAMPLES]

# ── MACS3 peak calling ────────────────────────────────────────────────────────
# --nomodel --nolambda: ATAC signal is not ChIP-like; skip local lambda model
# --shift -75 --extsize 150: centre reads on Tn5 cut sites (nucleosome-free regions)
rule macs3:
    input:
        bam = final_bam,
    output:
        peak    = str(OUTDIR / "peaks" / "{sample}_peaks.narrowPeak"),
        summit  = str(OUTDIR / "peaks" / "{sample}_summits.bed"),
        xls     = str(OUTDIR / "peaks" / "{sample}_peaks.xls"),
    params:
        name   = "{sample}",
        outdir = str(OUTDIR / "peaks"),
        gsize  = GENOME_SIZE,
    threads: 1
    resources:
        mem_mb = 8 * 1024,
    conda: "envs/macs3.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        macs3 callpeak \
            -t {input.bam} \
            -f BAMPE \
            -n {params.name} \
            --outdir {params.outdir} \
            -g {params.gsize} \
            --nomodel --nolambda \
            --shift -75 --extsize 150 \
            --keep-dup all \
            -q 0.01
        test -s {output.peak} || {{ echo 'ERROR: MACS3 narrowPeak empty' >&2; exit 1; }}
        """

# ── MultiQC ───────────────────────────────────────────────────────────────────
rule multiqc:
    input:
        expand(str(OUTDIR / "fastqc"  / "{sample}_R1_fastqc.zip"),    sample=SAMPLES),
        expand(str(OUTDIR / "fastp"   / "{sample}.json"),              sample=SAMPLES),
        expand(str(OUTDIR / "aligned" / "{sample}.markdup.flagstat"),  sample=SAMPLES),
    output:
        str(OUTDIR / "multiqc" / "multiqc_report.html"),
    conda: "envs/qc.yaml"
    shell:
        """
        set -euo pipefail
        multiqc {OUTDIR}/fastqc/ {OUTDIR}/fastp/ {OUTDIR}/aligned/ \
            -o {OUTDIR}/multiqc/ --force
        test -s {output} || {{ echo 'ERROR: MultiQC report empty' >&2; exit 1; }}
        """

# ── DiffBind: differential accessibility ─────────────────────────────────────
rule diffbind:
    input:
        # Use lambda helpers so the correct BAM suffix is used when BLACKLIST is set
        bams     = final_bam_list,
        bais     = final_bai_list,
        peaks    = expand(str(OUTDIR / "peaks"   / "{sample}_peaks.narrowPeak"), sample=SAMPLES),
        metadata = SAMPLESHEET,
    output:
        results  = str(OUTDIR / "diffbind" / "{contrast}_results.tsv"),
        volcano  = str(OUTDIR / "diffbind" / "{contrast}_volcano.pdf"),
        # pca_plot removed: "pca.pdf" is a fixed path but this rule has a {contrast}
        # wildcard, so declaring it as output would cause a wildcard conflict
        # (Snakemake would try to resolve {contrast} in a path that has none).
        # The R script writes pca.pdf directly via file.path(outdir, "pca.pdf").
    params:
        contrast    = "{contrast}",
        comparisons = COMPARISONS,
        padj        = PADJ_THRESH,
        lfc         = LFC_THRESH,
        outdir      = str(OUTDIR / "diffbind"),
        bam_dir     = str(OUTDIR / "aligned"),
        peak_dir    = str(OUTDIR / "peaks"),
    threads: THREADS
    resources:
        mem_mb = 64 * 1024,
    conda: "envs/r_diffbind.yaml"
    script: "scripts/diffbind.R"
